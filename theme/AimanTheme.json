{
  "name": "Tesco Brand Theme",
  "dataColors": [
    "#00539F",
    "#EE1C2E",
    "#FFC72C",
    "#00A3A6",
    "#E26B00",
    "#5C6B73",
    "#3373B2",
    "#85AECF"
  ],
  "background": "#F2F4F7",
  "foreground": "#262626",
  "tableAccent": "#00539F",
  "textClasses": {
    "callout": {
      "fontFace": "Tesco Modern, Segoe UI, Arial, sans-serif"
    },
    "title": {
      "fontFace": "Tesco Modern, Segoe UI, Arial, sans-serif"
    },
    "header": {
      "fontFace": "Tesco Modern, Segoe UI, Arial, sans-serif"
    },
    "label": {
      "fontFace": "Tesco Modern, Segoe UI, Arial, sans-serif"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F2F4F7" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E0E0E0" } },
            "radius": 4
          }
        ]
      }
    }
  }
}